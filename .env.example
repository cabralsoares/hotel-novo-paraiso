# Copie para ".env" (cp .env.example .env). Para o Docker, as variáveis principais já estão no docker-compose.yml.

# Porta e endereço (rodando sem Docker). Atrás de proxy, deixe em 127.0.0.1.
PORT=3100
HOST=127.0.0.1

# Onde ficam o banco (hotel.db), os backups diários e o código de primeiro acesso
DATA_DIR=./data

# Fuso do hotel (a data de "hoje" e os fechamentos usam este fuso, não o do servidor)
HOTEL_TZ=America/Recife

# Atrás do OpenResty/Nginx/Cloudflare: 1. Só funciona com segurança se a porta NÃO estiver aberta para a internet.
TRUST_PROXY=1
# Site em HTTPS: 1 (cookie de sessão marcado como Secure). Para testar por http em outro aparelho: 0.
COOKIE_SECURE=1

# Latência simulada do autorizador de cartão, em milissegundos (só no modo simulação)
# GATEWAY_LATENCY_MS=1100
